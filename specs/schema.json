{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilocrop.app/specs/schema.json",
  "title": "KiloCrop Portal Photo Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "title", "region", "status", "output", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 2, "maxLength": 120 },
    "shortLabel": { "type": "string", "minLength": 2, "maxLength": 32 },
    "region": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "status": { "type": "string", "enum": ["draft", "community", "checked", "stale"] },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "width", "height", "dpi", "format", "fileSizeKb"],
      "properties": {
        "units": { "type": "string", "enum": ["px", "mm"] },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "dpi": { "type": ["integer", "null"], "minimum": 72, "maximum": 1200 },
        "format": { "type": "string", "enum": ["jpeg", "png"] },
        "fileSizeKb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": ["integer", "null"], "minimum": 1 },
            "max": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      }
    },
    "backgroundHint": { "type": ["string", "null"] },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headHeightPct": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "minItems": 2,
          "maxItems": 2
        },
        "eyeLineFromTopPct": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceUrl", "archiveUrl", "verifiedOn"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["public-page", "authenticated-portal", "pasted-rule", "shared-query"]
        },
        "sourceUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "archiveUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "verifiedOn": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
